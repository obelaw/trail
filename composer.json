{
    "name": "obelaw/trail",
    "description": "Minimal, activity trail for Eloquent models.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "obelaw/twist": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Obelaw\\Trail\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Trail\\TrailServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}